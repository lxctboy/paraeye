<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pickButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1a. 选择图片（单帧验证）" />

        <Button
            android:id="@+id/pickVideoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1b. 选择视频（实时流水线）" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:text="播放 / 暂停" />

        <RadioGroup
            android:id="@+id/acceleratorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioCpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="CPU" />

            <RadioButton
                android:id="@+id/radioGpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="GPU" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/modelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <!-- P4：只剩自导出的 280x518 INT8 模型（FP32 版会让 APK 从 28MB 涨到 128MB） -->
            <RadioButton
                android:id="@+id/radioInt8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="INT8 280x518" />
        </RadioGroup>

        <Button
            android:id="@+id/runButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. 生成 3D（单帧推理 + 计时）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="视差强度（总视差占宽度比例）"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/dispSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="10" />

        <TextView
            android:id="@+id/dispLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前：1.0%（P0 定档，默认）"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/viewModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioModeDepth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="深度图" />

            <RadioButton
                android:id="@+id/radioModeSbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:checked="true"
                android:text="SBS 3D" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/swapCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="左右交换（交叉眼观看时用）" />

        <CheckBox
            android:id="@+id/fp16Check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPU FP16（更快，精度略降；仅 GPU 有效）" />

        <CheckBox
            android:id="@+id/flipCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="视频上下翻转（画面倒置时勾选）" />

        <android.opengl.GLSurfaceView
            android:id="@+id/glView"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
